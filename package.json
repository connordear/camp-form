{
  "name": "camp-form",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "build": "next build --turbopack",
    "start": "npx drizzle-kit migrate && next start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run ./src/lib/data/seed.ts",
    "db:seed:users": "bun run ./src/lib/data/seed-users.ts",
    "db:seed:campground": "bun run ./src/lib/data/seed-campground.ts",
    "db:seed:bookings": "bun run ./src/lib/data/seed-campground-bookings.ts",
    "db:seed:bookings:many": "bun run ./src/lib/data/seed-campground-bookings.ts --many",
    "db:up": "bun run db:generate && bun run db:migrate",
    "db:nuke": "bun ./src/lib/data/reset-db.ts",
    "db:reset": "bun ./src/lib/data/reset-db.ts && bun run db:migrate && bun run db:seed && bun run db:seed:users",
    "prepare": "husky"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "better-auth": "^1.7.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-to-print": "^3.3.0",
    "resend": "^6.38.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod-schema-faker": "^3.0.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ],
  "lint-staged": {
    "*.{js,ts,tsx,json,css}": [
      "biome check --write"
    ]
  }
}
